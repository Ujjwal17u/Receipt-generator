# ================================================
# ReceiptAI — Environment Configuration
# ================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit .env.local to git.

# ----- MongoDB Atlas -----
# Paste your MongoDB Atlas connection string here.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority

# ----- Database -----
DATABASE_NAME=receipt_ai
DEFAULT_BUSINESS_ID=default

# ----- Environment -----
NODE_ENV=development
PORT=3001

# ----- App -----
PUBLIC_APP_NAME=ReceiptAI
PUBLIC_APP_URL=http://localhost:8080
API_BASE_URL=http://localhost:3001/api

# ----- Security -----
# Minimum 32 chars for production. Used for signing tokens later.
JWT_SECRET=replace_me_with_a_long_random_string_32chars_min

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
